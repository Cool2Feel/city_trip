/* app.wxss - 全局样式 */

/* ========== CSS变量系统 ========== */
page {
  /* 主题色 */
  --primary: #4A90D9;
  --primary-light: #E8F1FC;
  --primary-dark: #357ABD;

  /* 功能色 */
  --success: #2e7d32;
  --warning: #f9a825;
  --danger: #d32f2f;
  --info: #1565c0;

  /* 中性色 */
  --text-1: #1a1a2e;
  --text-2: #4a4a68;
  --text-3: #8888a0;
  --text-4: #bbb;
  --bg-page: #f5f6f8;
  --bg-card: #ffffff;
  --bg-tag: #f0f2f5;
  --border: #ececf0;

  /* 11类调查方向配色 */
  --cat-concert: #d32f2f;
  --cat-sport: #7b1fa2;
  --cat-market: #f9a825;
  --cat-museum: #1565c0;
  --cat-scenic: #e65100;
  --cat-tea: #ec407a;
  --cat-food: #ad1457;
  --cat-walk: #00838f;
  --cat-mall: #4527a0;
  --cat-metro: #546e7a;
  --cat-ticket: #2e7d32;

  /* 圆角 */
  --radius-sm: 8rpx;
  --radius-md: 16rpx;
  --radius-lg: 24rpx;
  --radius-full: 999rpx;

  /* 阴影 */
  --shadow-sm: 0 2rpx 8rpx rgba(0,0,0,0.04);
  --shadow-md: 0 4rpx 20rpx rgba(0,0,0,0.08);
  --shadow-lg: 0 8rpx 32rpx rgba(0,0,0,0.12);

  background: var(--bg-page);
  color: var(--text-1);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Helvetica, Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ========== 通用布局 ========== */
.container {
  padding: 24rpx;
}

.flex-row {
  display: flex;
  flex-direction: row;
  align-items: center;
}

.flex-col {
  display: flex;
  flex-direction: column;
}

.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.flex-wrap {
  flex-wrap: wrap;
}

.flex-1 {
  flex: 1;
  min-width: 0;
}

/* ========== 卡片 ========== */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  margin-bottom: 24rpx;
}

.card-tap {
  transition: transform 0.15s ease, box-shadow 0.15s ease;
}

.card-tap:active {
  transform: scale(0.98);
  box-shadow: var(--shadow-md);
}

/* ========== 标签 ========== */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 20rpx;
  border-radius: var(--radius-full);
  font-size: 22rpx;
  font-weight: 500;
  background: var(--bg-tag);
  color: var(--text-3);
}

.tag-primary {
  background: var(--primary-light);
  color: var(--primary);
}

.tag-danger {
  background: rgba(211,47,47,0.1);
  color: var(--cat-concert);
}

.tag-success {
  background: rgba(46,125,50,0.1);
  color: var(--success);
}

.tag-warning {
  background: rgba(249,168,37,0.1);
  color: var(--warning);
}

/* ========== 标题 ========== */
.section-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: '';
  width: 8rpx;
  height: 32rpx;
  background: var(--primary);
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.subsection-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 16rpx;
}

/* ========== 文本 ========== */
.text-ellipsis {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.text-ellipsis-2 {
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.text-gray {
  color: var(--text-3);
  font-size: 24rpx;
}

.text-small {
  font-size: 22rpx;
}

.text-bold {
  font-weight: 600;
}

.text-primary {
  color: var(--primary);
}

/* ========== 按钮 ========== */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx 40rpx;
  border-radius: var(--radius-full);
  font-size: 30rpx;
  font-weight: 600;
  transition: all 0.2s;
}

.btn-primary {
  background: var(--primary);
  color: #fff;
}

.btn-primary:active {
  background: var(--primary-dark);
  transform: scale(0.97);
}

.btn-outline {
  background: transparent;
  border: 2rpx solid var(--primary);
  color: var(--primary);
}

.btn-outline:active {
  background: var(--primary-light);
}

.btn-disabled {
  background: #ddd;
  color: #999;
}

/* ========== 空状态 ========== */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 40rpx;
}

.empty-state .empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  opacity: 0.3;
}

.empty-state .empty-text {
  color: var(--text-3);
  font-size: 28rpx;
}

.empty-state .empty-retry-btn {
  margin-top: 32rpx;
  padding: 14rpx 48rpx;
  background: var(--primary);
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
  font-weight: 600;
}

/* ========== 加载 ========== */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255,255,255,0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.loading-spinner {
  width: 60rpx;
  height: 60rpx;
  border: 6rpx solid var(--primary-light);
  border-top-color: var(--primary);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  margin-top: 24rpx;
  color: var(--primary);
  font-size: 26rpx;
}

/* ========== 分割线 ========== */
.divider {
  height: 1rpx;
  background: var(--border);
  margin: 24rpx 0;
}

/* ========== 安全区域 ========== */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
