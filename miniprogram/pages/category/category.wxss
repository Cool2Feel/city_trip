/* pages/category/category.wxss */
.category-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 分类头部 */
.cat-header {
  padding: 48rpx 32rpx;
  color: #fff;
  position: relative;
  overflow: hidden;
}

.cat-header-content {
  position: relative;
  z-index: 1;
}

.cat-header-top {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.cat-header-icon {
  font-size: 56rpx;
}

.cat-header-letter {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.cat-header-name {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
  margin-bottom: 16rpx;
}

.cat-header-meta {
  display: flex;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.cat-header-tag,
.cat-header-count {
  font-size: 22rpx;
  color: #fff;
  background: rgba(255,255,255,0.2);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.cat-header-limited {
  font-size: 22rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(211,47,47,0.45);
  border: 1rpx solid rgba(255,255,255,0.4);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.cat-header-map-btn {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  margin-top: 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #fff;
  background: rgba(255,255,255,0.18);
  border: 1rpx solid rgba(255,255,255,0.35);
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
}

.cat-header-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  display: block;
  margin-bottom: 8rpx;
}

.cat-header-value {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  display: block;
}

/* 内容列表 */
.cat-content {
  padding: 24rpx 32rpx;
}

/* 活动卡片 */
.cat-item-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid var(--cat-color);
}

.cat-item-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 12rpx;
}

.cat-item-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  flex: 1;
  margin-right: 16rpx;
  line-height: 1.4;
}

.cat-item-price {
  font-size: 24rpx;
  color: var(--cat-color);
  font-weight: 600;
  background: rgba(0,0,0,0.04);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.cat-item-meta {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  margin-bottom: 8rpx;
}

.cat-meta-item {
  font-size: 24rpx;
  color: var(--text-3);
}

.cat-item-source {
  font-size: 20rpx;
  color: var(--text-4);
}

.cat-item-address {
  font-size: 24rpx;
  color: var(--text-3);
  display: block;
  margin-bottom: 6rpx;
}

.cat-item-note {
  font-size: 24rpx;
  color: var(--text-2);
}

/* 信息卡片 */
.cat-info-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid var(--cat-color);
}

.cat-info-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}

.cat-info-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  flex: 1;
}

.cat-info-expired {
  font-size: 20rpx;
  font-weight: 600;
  color: var(--warning);
  background: rgba(245, 166, 35, 0.15);
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  flex-shrink: 0;
}

.cat-info-price {
  font-size: 24rpx;
  color: var(--success);
  font-weight: 600;
  background: rgba(46,125,50,0.08);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.cat-info-rating {
  font-size: 24rpx;
  color: var(--warning);
  font-weight: 600;
}

.cat-info-meta {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cat-meta-text {
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.5;
}

.cat-info-extra {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.cat-info-extra-item {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
  display: block;
  margin-bottom: 6rpx;
}

.cat-info-source {
  font-size: 20rpx;
  color: var(--text-4);
  display: block;
  margin-top: 12rpx;
}

/* 地铁卡片 */
.cat-metro-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
  border-left: 6rpx solid var(--cat-color);
}

.cat-metro-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  display: block;
  margin-bottom: 12rpx;
}

.cat-metro-info {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.cat-metro-lines,
.cat-metro-exit {
  font-size: 24rpx;
  color: var(--text-2);
  background: var(--bg-page);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.cat-metro-note {
  font-size: 24rpx;
  color: var(--text-3);
}

/* 底部 */
.cat-footer {
  margin: 24rpx 32rpx 0;
  padding: 24rpx;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
}

.cat-query-info {
  margin-bottom: 16rpx;
}

.cat-query-label {
  font-size: 22rpx;
  color: var(--text-3);
  display: block;
  margin-bottom: 6rpx;
}

.cat-query-value {
  font-size: 24rpx;
  color: var(--text-2);
  font-family: monospace;
}

.cat-footer-text {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 数据来源标签 */
.cat-header-update {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
}

/* hover效果 */
.card-tap {
  opacity: 0.92;
  transform: scale(0.98);
}

/* 骨架屏 */
.cat-skeleton {
  padding: 24rpx 32rpx;
}

.skeleton-header {
  height: 240rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 24rpx;
}

.skeleton-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.skeleton-line {
  height: 28rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 16rpx;
}

.skeleton-line:last-child { margin-bottom: 0; }
.skeleton-line-short { width: 40%; }
.skeleton-line-long { width: 90%; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 周末过期提示 */
.expired-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 32rpx 0;
  background: #fff8e1;
  border: 1rpx solid #ffe082;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.expired-banner-icon {
  font-size: 30rpx;
}

.expired-banner-text {
  flex: 1;
  font-size: 26rpx;
  color: #8d6e00;
}

.expired-banner-action {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
}
