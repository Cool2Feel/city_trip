/* pages/discover/discover.wxss */
.discover-page {
  min-height: 100vh;
  padding: 24rpx 32rpx 40rpx;
}

/* 城市头部 */
.city-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.city-header-left {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  box-shadow: var(--shadow-sm);
}

.city-header-icon {
  font-size: 28rpx;
}

.city-header-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.city-header-arrow {
  font-size: 24rpx;
  color: var(--text-3);
}

.regenerate-btn {
  background: var(--primary-light);
  color: var(--primary);
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.regenerate-btn:active {
  opacity: 0.7;
}

/* 周末过期提示 */
.expired-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
  background: #fff8e1;
  border: 1rpx solid #ffe082;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.expired-banner-icon {
  font-size: 30rpx;
}

.expired-banner-text {
  flex: 1;
  font-size: 26rpx;
  color: #8d6e00;
}

.expired-banner-action {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
}

/* 未生成状态 */
.not-generated {
  margin-top: 24rpx;
}

.not-gen-card {
  background: linear-gradient(135deg, var(--primary) 0%, #2196F3 100%);
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  text-align: center;
  margin-bottom: 24rpx;
}

.not-gen-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 24rpx;
}

.not-gen-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 16rpx;
}

.not-gen-desc {
  font-size: 26rpx;
  color: rgba(255,255,255,0.85);
  line-height: 1.6;
  display: block;
  margin-bottom: 40rpx;
}

.not-gen-btn {
  background: #fff;
  color: var(--primary);
  font-size: 32rpx;
  padding: 24rpx 48rpx;
}

/* 内容流：顶部横幅 */
.feed-hero {
  background: linear-gradient(135deg, var(--primary) 0%, #2196F3 100%);
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
  color: #fff;
}

.feed-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.feed-hero-title {
  font-size: 38rpx;
  font-weight: 700;
}

.feed-hero-actions {
  display: flex;
  gap: 16rpx;
}

.quick-nav-mini {
  width: 72rpx;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  font-size: 32rpx;
  transition: transform 0.15s;
}

.quick-nav-mini:active {
  transform: scale(0.92);
}

.feed-hero-meta {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  display: block;
  margin-bottom: 8rpx;
}

.feed-hero-sub {
  font-size: 22rpx;
  color: rgba(255,255,255,0.75);
  display: block;
  margin-bottom: 20rpx;
}

.feed-hero-btn {
  background: #fff;
  color: var(--primary);
  font-size: 30rpx;
  padding: 20rpx 40rpx;
}

/* 亮点 */
.feed-highlights {
  margin-bottom: 24rpx;
}

.feed-section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 20rpx;
}

/* 主题精选横向卡片 */
.theme-picks-scroll {
  white-space: nowrap;
  width: 100%;
}

.theme-pick {
  display: inline-flex;
  flex-direction: column;
  width: 320rpx;
  height: 180rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  margin-right: 20rpx;
  vertical-align: top;
  white-space: normal;
  color: #fff;
}

.theme-pick:last-child {
  margin-right: 0;
}

.theme-pick-top {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.theme-pick-icon {
  font-size: 34rpx;
}

.theme-pick-label {
  font-size: 26rpx;
  font-weight: 600;
  opacity: 0.95;
}

.theme-pick-name {
  font-size: 30rpx;
  font-weight: 700;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  margin-bottom: 8rpx;
}

.theme-pick-meta {
  font-size: 22rpx;
  opacity: 0.9;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* 分类精选流 */
.feed-groups {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feed-group {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx 0 28rpx;
  box-shadow: var(--shadow-sm);
}

.feed-group-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 28rpx 20rpx;
}

.feed-group-name {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
}

.feed-group-top3 {
  margin-left: auto;
  margin-right: 12rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: var(--primary);
  background: var(--primary-light);
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
}

.feed-group-more {
  display: flex;
  align-items: center;
  gap: 4rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.feed-group-arrow {
  font-size: 26rpx;
}

.feed-scroll {
  white-space: nowrap;
  width: 100%;
}

.feed-item {
  display: inline-flex;
  flex-direction: column;
  width: 300rpx;
  margin-left: 24rpx;
  padding: 20rpx;
  background: var(--bg-page);
  border-radius: 16rpx;
  white-space: normal;
  vertical-align: top;
}

.feed-item:last-child {
  margin-right: 28rpx;
}

.feed-item-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.feed-item-meta {
  font-size: 22rpx;
  color: var(--text-3);
  line-height: 1.4;
  margin-bottom: 8rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.feed-item-price {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
  margin-top: auto;
}

.hover-bg {
  background: var(--bg-tag);
}

/* 内容加载骨架屏 */
.feed-skeleton {
  padding: 0 32rpx;
}

.feed-skeleton .skeleton-hero {
  height: 220rpx;
  border-radius: 24rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: feedShimmer 1.5s infinite;
  margin-bottom: 24rpx;
}

.feed-skeleton .skeleton-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.feed-skeleton .skeleton-line {
  height: 28rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: feedShimmer 1.5s infinite;
  margin-bottom: 16rpx;
}

.feed-skeleton .skeleton-line:last-child {
  margin-bottom: 0;
}

.feed-skeleton .skeleton-line-short {
  width: 40%;
}

.feed-skeleton .skeleton-line-long {
  width: 90%;
}

@keyframes feedShimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 重新生成：调研工作流进度 */
.regenerating {
  padding: 24rpx 32rpx;
}

.regen-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

.regen-head {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 10rpx;
}

.regen-spinner {
  font-size: 40rpx;
  animation: regenSpin 1.2s linear infinite;
  flex-shrink: 0;
}

@keyframes regenSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.regen-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}

.regen-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin-bottom: 24rpx;
}

.regen-steps {
  border-top: 1rpx solid var(--bg-tag);
  padding-top: 8rpx;
}

.regen-step {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 14rpx 0;
}

.regen-step-no {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: var(--bg-tag);
  color: var(--text-3);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.regen-step.active .regen-step-no {
  background: var(--primary);
  color: #fff;
}

.regen-step.done .regen-step-no {
  background: #e8f5e9;
  color: #2e7d32;
}

.regen-step-body {
  flex: 1;
}

.regen-step-name {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--text-1);
  display: block;
}

.regen-step-detail {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 2rpx;
  display: block;
}

.regen-step-status {
  font-size: 24rpx;
  color: var(--primary);
  flex-shrink: 0;
}

.regen-step.done .regen-step-status {
  color: #2e7d32;
}

.regen-progress {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--text-3);
  text-align: center;
}
