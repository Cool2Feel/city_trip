/* pages/city-select/city-select.wxss */
.city-select-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 搜索栏 */
.search-bar {
  padding: 24rpx 32rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 10;
  box-shadow: var(--shadow-sm);
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: var(--bg-page);
  border-radius: 999rpx;
  padding: 16rpx 28rpx;
  gap: 12rpx;
}

.search-icon {
  font-size: 28rpx;
  opacity: 0.5;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}

.search-placeholder {
  color: var(--text-3);
  font-size: 28rpx;
}

.search-clear {
  font-size: 28rpx;
  color: var(--text-3);
  padding: 4rpx 8rpx;
}

/* Section */
.section {
  padding: 0 32rpx;
  margin-top: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 24rpx;
}

/* 热门城市 */
.hot-cities {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.hot-city-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: #fff;
  border: 2rpx solid var(--border);
  border-radius: 999rpx;
  padding: 16rpx 36rpx;
  transition: all 0.2s;
}

.hot-city-chip.active {
  background: var(--primary-light);
  border-color: var(--primary);
}

.hot-city-chip-name {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
}

.hot-city-chip.active .hot-city-chip-name {
  color: var(--primary);
}

.hot-city-chip-check {
  font-size: 28rpx;
  color: var(--primary);
  font-weight: 700;
}

/* 城市列表 */
.city-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.city-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  box-shadow: var(--shadow-sm);
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.city-item.active {
  border-color: var(--primary);
  background: var(--primary-light);
}

.city-item-left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.city-item-name {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
}

.city-item-province {
  font-size: 22rpx;
  color: var(--text-3);
}

.city-item-right {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.city-item-desc {
  font-size: 24rpx;
  color: var(--text-3);
}

.city-item-check {
  font-size: 32rpx;
  color: var(--primary);
  font-weight: 700;
}

/* hover效果 */
.card-tap {
  opacity: 0.92;
  transform: scale(0.98);
}

/* 骨架屏 */
.city-skeleton {
  padding: 0 32rpx;
  margin-top: 32rpx;
}

.skeleton-section-title {
  height: 40rpx;
  width: 200rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 20rpx;
}

.skeleton-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.skeleton-chip {
  width: 140rpx;
  height: 64rpx;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

.skeleton-city-item {
  height: 120rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 16rpx;
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
