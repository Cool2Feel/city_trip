<!-- pages/city-select/city-select.wxml - v3.0 触感反馈 + 骨架屏 -->
<view class="city-select-page">
  <!-- 搜索栏 -->
  <view class="search-bar">
    <view class="search-input-wrap">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        type="text"
        placeholder="搜索城市名称或拼音"
        placeholder-class="search-placeholder"
        value="{{searchKey}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <text class="search-clear" wx:if="{{searchKey}}" bindtap="clearSearch">✕</text>
    </view>
  </view>

  <!-- 热门城市 -->
  <view class="section" wx:if="{{!searchKey && !loading}}">
    <view class="section-title">🔥 热门城市</view>
    <view class="hot-cities">
      <view
        class="hot-city-chip {{currentCityCode === item.code ? 'active' : ''}}"
        wx:for="{{hotCities}}"
        wx:key="code"
        data-code="{{item.code}}"
        bindtap="selectCity"
        hover-class="card-tap"
      >
        <text class="hot-city-chip-name">{{item.name}}</text>
        <text class="hot-city-chip-check" wx:if="{{currentCityCode === item.code}}">✓</text>
      </view>
    </view>
  </view>

  <!-- 全部城市 -->
  <view class="section" wx:if="{{!loading}}">
    <view class="section-title">{{searchKey ? '搜索结果' : '全部城市'}}</view>
    <view class="city-list">
      <view
        class="city-item {{currentCityCode === item.code ? 'active' : ''}}"
        wx:for="{{filteredCities}}"
        wx:key="code"
        data-code="{{item.code}}"
        bindtap="selectCity"
        hover-class="card-tap"
      >
        <view class="city-item-left">
          <text class="city-item-name">{{item.name}}</text>
          <text class="city-item-province">{{item.province}}</text>
        </view>
        <view class="city-item-right">
          <text class="city-item-desc">{{item.desc}}</text>
          <text class="city-item-check" wx:if="{{currentCityCode === item.code}}">✓</text>
        </view>
      </view>
    </view>

    <!-- 空搜索结果 -->
    <view class="empty-state" wx:if="{{searchKey && filteredCities.length === 0}}">
      <text class="empty-icon">🔍</text>
      <text class="empty-text">未找到匹配的城市</text>
    </view>
  </view>

  <!-- 骨架屏 -->
  <view class="city-skeleton" wx:if="{{loading}}">
    <view class="skeleton-section-title"></view>
    <view class="skeleton-chip-row">
      <view class="skeleton-chip" wx:for="{{[1,2,3,4,5]}}" wx:key="*this"></view>
    </view>
    <view class="skeleton-section-title" style="margin-top: 32rpx;"></view>
    <view class="skeleton-city-item" wx:for="{{[1,2,3,4,5,6,7]}}" wx:key="*this"></view>
  </view>
</view>
