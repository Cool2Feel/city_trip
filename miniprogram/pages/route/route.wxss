/* pages/route/route.wxss */
.route-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 路线Tab */
.route-tabs {
  display: flex;
  background: #fff;
  padding: 16rpx 24rpx;
  gap: 12rpx;
  box-shadow: var(--shadow-sm);
}

.route-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 8rpx;
  border-radius: 16rpx;
  background: var(--bg-page);
  transition: all 0.2s;
  border: 2rpx solid transparent;
}

.route-tab.active {
  background: #fff;
  border-color: var(--route-color);
  box-shadow: 0 0 0 1rpx var(--route-color);
}

.route-tab-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.route-tab-name {
  font-size: 22rpx;
  color: var(--text-3);
  font-weight: 500;
}

.route-tab.active .route-tab-name {
  color: var(--route-color);
}

.route-tab-label {
  font-size: 22rpx;
  color: var(--text-1);
  font-weight: 600;
  text-align: center;
  margin-top: 2rpx;
}

/* 路线封面图 */
.route-cover {
  width: 100%;
  height: 320rpx;
  display: block;
}

/* 路线头部 */
.route-header {
  padding: 40rpx 32rpx;
  color: #fff;
  margin-bottom: 24rpx;
}

.route-header-top {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.route-header-icon {
  font-size: 56rpx;
}

.route-header-info {
  flex: 1;
}

.route-header-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 8rpx;
}

.route-header-desc {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

.route-header-meta {
  display: flex;
  align-items: center;
  justify-content: space-around;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 24rpx 0;
}

.route-meta-item {
  text-align: center;
  flex: 1;
}

.route-meta-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  display: block;
  margin-bottom: 4rpx;
}

.route-meta-label {
  font-size: 20rpx;
  color: rgba(255,255,255,0.7);
}

.route-meta-divider {
  width: 1rpx;
  height: 48rpx;
  background: rgba(255,255,255,0.2);
}

/* 时间线 */
.route-timeline-container {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

.route-timeline-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 24rpx;
}

.route-timeline {
  display: flex;
  flex-direction: column;
}

.timeline-item {
  display: flex;
  gap: 24rpx;
  padding-bottom: 24rpx;
}

.timeline-item:last-child {
  padding-bottom: 0;
}

.timeline-left {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.timeline-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #fff;
}

.timeline-dot-num {
  font-size: 24rpx;
  font-weight: 700;
}

.timeline-line {
  width: 4rpx;
  flex: 1;
  margin-top: 8rpx;
  min-height: 60rpx;
}

.timeline-right {
  flex: 1;
  min-width: 0;
  padding-top: 2rpx;
}

.timeline-time {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
  display: block;
}

.timeline-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  box-shadow: var(--shadow-sm);
}

.timeline-activity {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
  display: block;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

.timeline-meta {
  margin-bottom: 8rpx;
}

.timeline-location {
  font-size: 24rpx;
  color: var(--text-3);
}

.timeline-note {
  margin-top: 8rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid var(--border);
}

.timeline-note-text {
  font-size: 22rpx;
  color: var(--warning);
  line-height: 1.5;
}

/* 操作 */
.route-actions {
  padding: 0 32rpx;
  margin-bottom: 32rpx;
}

/* 路线地图卡片（A2）*/
.route-map-card {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 16rpx;
  box-shadow: var(--shadow-sm);
  overflow: hidden;
}

.route-map-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
}

.route-map-title {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
}

.route-map-icon {
  font-size: 32rpx;
}

.route-map-sub {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.route-map-count {
  font-size: 22rpx;
  color: var(--text-3);
}

.route-map-toggle {
  font-size: 24rpx;
  font-weight: 600;
  color: var(--primary);
}

.route-map-body {
  padding: 0 24rpx 24rpx;
}

.route-map-view {
  width: 100%;
  height: 420rpx;
  border-radius: 16rpx;
  display: block;
}

.route-map-hint {
  display: block;
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 12rpx;
  line-height: 1.5;
}

.route-map-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 24rpx;
}

.route-map-empty-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
}

.route-map-empty-text {
  font-size: 24rpx;
  color: var(--text-3);
  text-align: center;
}

/* 预算卡片（A4）*/
.route-budget-card {
  margin: 24rpx 32rpx 0;
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(249,168,37,0.18);
}

.route-budget-empty {
  border-color: var(--border);
}

.route-budget-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.route-budget-title {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
}

.route-budget-sub {
  font-size: 20rpx;
  color: var(--text-3);
}

.route-budget-grid {
  display: flex;
  gap: 16rpx;
}

.budget-item {
  flex: 1;
  background: var(--bg-page);
  border-radius: 12rpx;
  padding: 20rpx 12rpx;
  text-align: center;
}

.budget-item-total {
  background: rgba(74,144,217,0.08);
}

.budget-value {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 6rpx;
}

.budget-label {
  font-size: 20rpx;
  color: var(--text-3);
}

.route-budget-note {
  display: block;
  font-size: 20rpx;
  color: var(--text-3);
  margin-top: 16rpx;
  line-height: 1.5;
}

/* 时间线个人标记（A3）*/
.timeline-mark {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.timeline-mark-pill {
  font-size: 22rpx;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: var(--bg-page);
  color: var(--text-3);
  border: 1rpx solid var(--border);
}

.timeline-mark-pill.want {
  background: rgba(249,168,37,0.12);
  color: #b8860b;
  border-color: rgba(249,168,37,0.4);
}

.timeline-mark-pill.done {
  background: rgba(46,125,50,0.12);
  color: #2e7d32;
  border-color: rgba(46,125,50,0.4);
}

.timeline-note-btn {
  font-size: 22rpx;
  color: var(--primary);
  padding: 6rpx 12rpx;
}

.timeline-user-note {
  margin-top: 10rpx;
  border-top: none;
  background: rgba(74,144,217,0.06);
  padding: 8rpx 12rpx;
  border-radius: 8rpx;
}

/* 备注弹窗（A3）*/
.note-mask {
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,0.45);
  z-index: 50;
}

.note-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx 48rpx;
  z-index: 51;
  box-shadow: 0 -8rpx 30rpx rgba(0,0,0,0.12);
}

.note-sheet-title {
  font-size: 30rpx;
  font-weight: 700;
  color: var(--text-1);
}

.note-sheet-activity {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  margin: 8rpx 0 20rpx;
}

.note-sheet-input {
  width: 100%;
  height: 200rpx;
  background: var(--bg-page);
  border-radius: 16rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: var(--text-1);
  box-sizing: border-box;
}

.note-sheet-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 24rpx;
}

.note-sheet-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.note-sheet-btn.cancel {
  background: var(--bg-page);
  color: var(--text-2);
}

.note-sheet-btn.confirm {
  background: var(--primary);
  color: #fff;
}

.route-action-btn {
  width: 100%;
}

/* 温馨提示 */
.route-tips {
  margin: 0 32rpx;
  background: rgba(249,168,37,0.06);
  border: 1rpx solid rgba(249,168,37,0.15);
  border-radius: 16rpx;
  padding: 24rpx;
}

.route-tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--warning);
  margin-bottom: 16rpx;
}

.route-tips-list {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.route-tip-item {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.6;
}

/* 数据来源标签 */
.route-data-source {
  margin-top: 16rpx;
}

.ds-update-time {
  font-size: 22rpx;
  color: rgba(255,255,255,0.7);
}
.ds-cloud { background: rgba(33,150,243,0.3); }

/* 周末过期提示 */
.expired-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 24rpx 32rpx 0;
  background: #fff8e1;
  border: 1rpx solid #ffe082;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
}

.expired-banner-icon {
  font-size: 30rpx;
}

.expired-banner-text {
  flex: 1;
  font-size: 26rpx;
  color: #8d6e00;
}

.expired-banner-action {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
}

/* 交通估算 */
.timeline-travel {
  margin-top: 8rpx;
  padding: 6rpx 12rpx;
  background: var(--bg-page);
  border-radius: 8rpx;
}

.timeline-travel-text {
  font-size: 20rpx;
  color: var(--text-3);
}

/* B级：智能重排（路线按距离就近重排）*/
.opt-toggle {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  font-weight: 600;
  color: #4A90D9;
  background: rgba(74, 144, 217, 0.12);
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}
.opt-toggle.on {
  color: #fff;
  background: #07c160;
}
.opt-toggle.disabled {
  color: var(--text-4);
  background: rgba(0, 0, 0, 0.05);
}
.opt-toggle-icon { font-size: 22rpx; }
.opt-toggle-text { font-size: 22rpx; }

.opt-banner {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
  background: rgba(7, 193, 96, 0.10);
  border: 1rpx solid rgba(7, 193, 96, 0.28);
  border-radius: 14rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}
.opt-banner-icon { font-size: 26rpx; line-height: 1.4; }
.opt-banner-text {
  font-size: 22rpx;
  color: #07a050;
  line-height: 1.5;
  flex: 1;
}

.timeline-orig-time {
  display: block;
  font-size: 18rpx;
  color: var(--text-4);
  margin-top: 4rpx;
}

/* hover效果 */
.card-tap {
  opacity: 0.92;
  transform: scale(0.98);
}

/* 骨架屏 */
.route-skeleton {
  padding: 0 32rpx;
}

.skeleton-tabs {
  height: 100rpx;
  border-radius: 12rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 16rpx;
}

.skeleton-cover {
  height: 320rpx;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 24rpx;
}

.skeleton-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.skeleton-line {
  height: 28rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
  margin-bottom: 16rpx;
}

.skeleton-line:last-child { margin-bottom: 0; }
.skeleton-line-time { width: 30%; }
.skeleton-line-short { width: 40%; }

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

/* 空状态 */
.route-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 32rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: var(--text-3);
}

.empty-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--text-4);
  text-align: center;
}

.empty-action {
  margin-top: 40rpx;
}
