/* pages/packing/packing.wxss */
.packing-page {
  min-height: 100vh;
  padding-bottom: 60rpx;
}

/* 头部 */
.packing-header {
  position: relative;
  padding: 56rpx 32rpx 72rpx;
  overflow: hidden;
}

.packing-header-bg {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, #4A90D9 0%, #2196F3 100%);
}

.packing-header-content {
  position: relative;
  z-index: 1;
}

.packing-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 8rpx;
}

.packing-sub {
  font-size: 24rpx;
  color: rgba(255,255,255,0.85);
}

/* 进度卡 */
.packing-progress-card {
  margin: -40rpx 32rpx 0;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 28rpx 24rpx;
  box-shadow: var(--shadow-md);
  position: relative;
  z-index: 2;
}

.packing-progress-top {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.packing-progress-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.packing-progress-value {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 600;
}

.packing-progress-bar {
  height: 16rpx;
  background: var(--bg-page);
  border-radius: 999rpx;
  overflow: hidden;
}

.packing-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #4A90D9, #2196F3);
  border-radius: 999rpx;
  transition: width 0.3s;
}

.packing-progress-tip {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 14rpx;
}

/* 分类 */
.packing-groups {
  padding: 0 32rpx;
  margin-top: 28rpx;
}

.packing-group {
  background: #fff;
  border-radius: 16rpx;
  padding: 8rpx 24rpx 16rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-sm);
}

.packing-group-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 18rpx 0 12rpx;
  border-bottom: 1rpx solid var(--border);
  margin-bottom: 8rpx;
}

.packing-group-icon {
  font-size: 30rpx;
}

.packing-group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-1);
}

.packing-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 16rpx 0;
}

.packing-check {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 2rpx solid var(--border);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  color: #fff;
  font-size: 24rpx;
}

.packing-check.checked {
  background: var(--primary);
  border-color: var(--primary);
}

.packing-item-text {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
}

.packing-item-text.checked {
  color: var(--text-3);
  text-decoration: line-through;
}

.packing-item-del {
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-page);
  border-radius: 50%;
  color: var(--text-3);
  font-size: 22rpx;
  flex-shrink: 0;
}

.packing-item-del:active {
  background: rgba(211,47,47,0.12);
  color: var(--danger);
}

/* 自定义添加 */
.packing-add-card {
  margin: 0 32rpx;
  display: flex;
  gap: 16rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 16rpx;
  box-shadow: var(--shadow-sm);
}

.packing-add-input {
  flex: 1;
  background: var(--bg-page);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 26rpx;
  color: var(--text-1);
}

.packing-add-btn {
  background: var(--primary);
  color: #fff;
  border-radius: 12rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
}

/* 操作 */
.packing-actions {
  padding: 0 32rpx;
  margin-top: 24rpx;
  display: flex;
  gap: 16rpx;
}

.packing-action-btn {
  flex: 1;
}

/* 底部 */
.packing-footer {
  text-align: center;
  padding: 32rpx;
}

.packing-footer text {
  font-size: 20rpx;
  color: var(--text-4);
}
