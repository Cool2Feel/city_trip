/* pages/home/home.wxss */
.home-page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* Hero区域 */
.hero {
  position: relative;
  padding: 0 32rpx 48rpx;
  overflow: hidden;
}

.hero-bg-img {
  position: absolute;
  top: 0; left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
}

.hero-bg-overlay {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: linear-gradient(135deg, rgba(26,35,60,0.72) 0%, rgba(26,35,60,0.45) 50%, rgba(26,35,60,0.68) 100%);
  z-index: 1;
}

.hero-content {
  position: relative;
  z-index: 2;
}

/* 城市选择器 */
.city-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.city-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: rgba(255,255,255,0.2);
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  backdrop-filter: blur(10px);
}

.city-icon {
  font-size: 28rpx;
}

.city-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}

.city-arrow {
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
}

.fav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  font-size: 32rpx;
  color: rgba(255,255,255,0.6);
}

.fav-btn.active {
  color: #FFD700;
}

/* 周末日期 */
.weekend-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.weekend-label {
  font-size: 24rpx;
  color: rgba(255,255,255,0.7);
  background: rgba(255,255,255,0.15);
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}

.weekend-date {
  font-size: 26rpx;
  color: rgba(255,255,255,0.95);
  font-weight: 500;
}

.weekend-sep {
  font-size: 26rpx;
  color: rgba(255,255,255,0.5);
}

/* Slogan */
.slogan {
  margin-bottom: 40rpx;
}

.slogan-main {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #fff;
  line-height: 1.4;
  margin-bottom: 12rpx;
}

.slogan-sub {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.8);
  line-height: 1.5;
}

/* 快捷按钮 */
.hero-actions {
  display: flex;
  gap: 20rpx;
}

.hero-btn {
  flex: 1;
  background: #fff;
  color: var(--primary);
  font-size: 30rpx;
}

.hero-btn:active {
  transform: scale(0.97);
}

.hero-btn-outline {
  flex: 1;
  background: rgba(255,255,255,0.15);
  border: 2rpx solid rgba(255,255,255,0.4);
  color: #fff;
}

.hero-btn-outline:active {
  background: rgba(255,255,255,0.25);
}

/* 全局搜索入口 */
.search-entry {
  display: flex;
  align-items: center;
  margin: 20rpx 32rpx 0;
  background: #fff;
  border-radius: 32rpx;
  padding: 20rpx 28rpx;
  box-shadow: var(--shadow-sm);
}

.search-entry-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-entry-placeholder {
  font-size: 26rpx;
  color: #999;
}

/* Section通用 */
.section {
  padding: 0 32rpx;
  margin-top: 32rpx;
}

.section .section-title {
  margin-bottom: 24rpx;
  color: var(--text-1);
  font-size: 32rpx;
  font-weight: 700;
}

.section .section-title::before {
  display: none;
}

/* 热门城市网格 */
.hot-cities-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.hot-city-card {
  width: calc(50% - 10rpx);
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.15s;
}

.hot-city-card:active {
  transform: scale(0.97);
}

.hot-city-name {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 8rpx;
}

.hot-city-desc {
  font-size: 24rpx;
  color: var(--text-3);
}

/* 概览卡片 */
.overview-card {
  transition: transform 0.15s;
}

.overview-card:active {
  transform: scale(0.98);
}

.overview-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.overview-icon {
  font-size: 36rpx;
  margin-right: 12rpx;
}

.overview-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  flex: 1;
}

.overview-arrow {
  font-size: 40rpx;
  color: var(--text-3);
}

.overview-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.overview-item {
  width: calc(33.33% - 11rpx);
  background: var(--bg-page);
  border-radius: 16rpx;
  padding: 20rpx 16rpx;
  text-align: center;
}

.overview-value {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.2;
}

.overview-label {
  display: block;
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 4rpx;
}

.overview-weather {
  background: var(--primary-light);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
}

.weather-text {
  font-size: 24rpx;
  color: var(--primary);
  font-weight: 500;
}

.weather-source {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 数据更新时间 */
.overview-data-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--border);
}

.data-update-time {
  font-size: 22rpx;
  color: var(--text-3);
}

/* 周末过期提示 */
.expired-banner {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #fff8e1;
  border: 1rpx solid #ffe082;
  border-radius: 16rpx;
}

.expired-banner-icon {
  font-size: 28rpx;
}

.expired-banner-text {
  flex: 1;
  font-size: 24rpx;
  color: #b26a00;
}

.expired-banner-action {
  font-size: 24rpx;
  font-weight: 600;
  color: #4A90D9;
}

.data-stale-hint {
  font-size: 22rpx;
  color: #ff9800;
}

/* 亮点列表 */
.highlights-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.highlight-item {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
}

.highlight-dot {
  font-size: 16rpx;
  color: var(--primary);
  margin-top: 8rpx;
  flex-shrink: 0;
}

.highlight-text {
  font-size: 28rpx;
  color: var(--text-2);
  line-height: 1.6;
  flex: 1;
}

/* 快捷导航 */
.quick-nav {
  display: flex;
  justify-content: space-around;
  background: #fff;
  border-radius: 24rpx;
  padding: 28rpx 0;
  box-shadow: var(--shadow-sm);
  margin-top: 24rpx;
}

.quick-nav-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  transition: transform 0.15s;
}

.quick-nav-item:active {
  transform: scale(0.92);
}

.quick-nav-icon {
  font-size: 48rpx;
}

.quick-nav-label {
  font-size: 22rpx;
  color: var(--text-2);
  font-weight: 500;
}

/* 功能列表 */
.feature-list {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.feature-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.feature-num {
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--primary);
  color: #fff;
  border-radius: 50%;
  font-size: 26rpx;
  font-weight: 700;
}

.feature-content {
  flex: 1;
}

.feature-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-1);
  margin-bottom: 6rpx;
}

.feature-desc {
  display: block;
  font-size: 24rpx;
  color: var(--text-3);
  line-height: 1.5;
}

/* 报告加载骨架屏 */
.home-skeleton {
  padding: 0 32rpx;
}

.home-skeleton .skeleton-header {
  height: 200rpx;
  border-radius: 20rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: homeShimmer 1.5s infinite;
  margin-bottom: 24rpx;
}

.home-skeleton .skeleton-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 16rpx;
  box-shadow: var(--shadow-sm);
}

.home-skeleton .skeleton-line {
  height: 28rpx;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #f0f0f0 25%, #e8e8e8 50%, #f0f0f0 75%);
  background-size: 200% 100%;
  animation: homeShimmer 1.5s infinite;
  margin-bottom: 16rpx;
}

.home-skeleton .skeleton-line:last-child {
  margin-bottom: 0;
}

.home-skeleton .skeleton-line-short {
  width: 40%;
}

.home-skeleton .skeleton-line-long {
  width: 90%;
}

@keyframes homeShimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
